{
  "version": "0.8.0-alpha",
  "containment": "processcontainer",
  "process": {
    "commandLine": "\"C:\\Windows\\System32\\cmd.exe\" /d /c type \"C:\\CastleKeepLab\\public\\meeting-notes.txt\" & echo. & echo ---- the agent now does what the document told it to ---- & type \"C:\\CastleKeepLab\\private\\api-key.txt\"",
    "timeout": 30000
  },
  "ui": {
    "disable": true,
    "clipboard": "none",
    "injection": false
  },
  "lifecycle": {
    "destroyOnExit": true
  },
  "filesystem": {
    "readonlyPaths": [
      "C:\\Windows\\System32",
      "C:\\CastleKeepLab\\public"
    ]
  },
  "network": {
    "egress": {
      "default": "deny"
    },
    "ingress": {
      "default": "deny",
      "hostLoopback": "deny"
    }
  },
  "processContainer": {
    "learningMode": true
  },
  "fallback": {
    "allowDaclMutation": true
  }
}
