{
  "version": "0.8.0-alpha",
  "containment": "processcontainer",
  "process": {
    "commandLine": "\"C:\\Windows\\System32\\cmd.exe\" /d /c echo hello from inside the sandbox",
    "timeout": 30000
  },
  "ui": {
    "disable": true,
    "clipboard": "none",
    "injection": false
  },
  "lifecycle": {
    "destroyOnExit": true
  },
  "filesystem": {
    "readonlyPaths": [
      "C:\\Windows\\System32"
    ]
  },
  "network": {
    "egress": {
      "default": "deny"
    },
    "ingress": {
      "default": "deny",
      "hostLoopback": "deny"
    }
  },
  "processContainer": {
    "learningMode": true
  },
  "fallback": {
    "allowDaclMutation": true
  }
}
