# Python
__pycache__/
*.pyc
*.pyo

# Machine-specific verify output (regenerated by verify.py)
/VERIFY-REPORT.md
/verify-report.json

# Phase 1 run transcripts (host-specific, timestamped)
/PHASE1-RUN-*.txt

# Runtime artifacts
/receipts/
/.verify/
/logs/

# Whoever is sitting at this machine: what they named their base agent, which
# face each agent wears, the three dummy account names and the chosen theme.
# Forty people clone the same repo; the name they type is theirs.
/profile.json

# Each participant's own mailbox: the base agent's global view. Laid down on
# first run from the seed in core/mailbox.py and mutated from then on by
# whatever that agent is allowed to do. Delete it for a clean one.
/mailbox/

# The four persona agents' sealed worlds, plus everything they have produced.
# Seeded on first run from core/vault.py. Not in git for the same reason the
# mailbox is not: forty people pushing their own invented doctor's
# appointments at each other is not a feature.
/vault/

# Per-subagent policies, written at the end of setup and then edited live.
# They are the artefact of the exercise, not an input to it.
/policies/

# Generated by verify/test runs inside the workspace
/workspace/verify-*.txt
