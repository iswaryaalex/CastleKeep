# Python
__pycache__/
*.pyc
*.pyo

# Machine-specific verify output (regenerated by verify.py)
/VERIFY-REPORT.md
/verify-report.json

# Phase 1 run transcripts (host-specific, timestamped)
/PHASE1-RUN-*.txt

# Runtime artifacts
/receipts/
/.verify/
/logs/

# Whoever is sitting at this machine, and what they named their agent.
# Forty people clone the same repo; the name they type is theirs.
/profile.json

# Each participant's own mailbox. Laid down on first run from
# workshop/mailbox-seed.json (which IS committed) and mutated from then on by
# whatever the triage agent is allowed to do. Delete it for a clean one.
/mailbox/

# Per-subagent policies, written at the end of setup and then edited live.
# They are the artefact of the exercise, not an input to it.
/policies/

# Generated by verify/test runs inside the workspace
/workspace/verify-*.txt
